{
  "name": "duratom",
  "version": "0.1.0",
  "description": "Durable, live Jotai atoms over a Y.Doc: typed reads, validated writes, re-renders only on change.",
  "keywords": [
    "atoms",
    "collaboration",
    "crdt",
    "jotai",
    "local-first",
    "react",
    "standard-schema",
    "yjs"
  ],
  "homepage": "https://duratom.karolnov.dev",
  "bugs": {
    "url": "https://github.com/KarolNov/duratom/issues"
  },
  "license": "MIT",
  "author": "Karol Novljaković",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarolNov/duratom.git"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "docs": "node scripts/docs.ts",
    "docs:check": "node scripts/docs.ts --check && tsc -p docs/tsconfig.json && tsc -p docs/snippets/server/tsconfig.json",
    "site:build": "node scripts/site.ts",
    "site:dev": "pnpm site:build && wrangler dev --config site/wrangler.jsonc",
    "site:deploy": "pnpm site:build && wrangler deploy --config site/wrangler.jsonc",
    "example:sync:deploy": "pnpm build && pnpm --filter duratom-example-sync run deploy",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "arktype": "^2.2.8",
    "jotai": "^3.0.1",
    "jotai-family": "1.1.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "partyserver": "0.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.2",
    "vitepress": "1.6.4",
    "vitest": "^5.0.3",
    "wrangler": "4.156.0",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "jotai": "^2.9.0 || ^3.0.0",
    "jotai-family": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "yjs": "^13.6.33"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@9.12.3"
}

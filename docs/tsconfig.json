{
  // Compiles the doc snippets and the TSDoc examples against the source, as an app would import it.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "duratom": ["../src/index.ts"],
      "duratom/react": ["../src/react/index.ts"],
      "duratom/core": ["../src/core/index.ts"]
    }
  },
  "include": ["snippets", "tsdoc-examples"],
  "exclude": ["snippets/server"]
}
